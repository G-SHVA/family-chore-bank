VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Family Chore Bank

# Kiosk auto-login (single shared parent/admin session).
# WARNING: Vite inlines these into the client bundle. Prefer a dedicated
# low-privilege "kiosk" parent account, not a personal admin login.
VITE_KIOSK_LOGIN_EMAIL=
VITE_KIOSK_LOGIN_PASSWORD=
